# Bellboy Robot API
BELLBOY_API_KEY=your-api-key-from-account-settings
ROBOT_SYSID=BILLIE-10

# OpenAI (for failure analysis)
OPENAI_API_KEY=sk-your-key-here

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Local Storage
DATABASE_URL=sqlite:///./memory/metadata.db
MEMORY_DIR=./memory

# Service Configuration
LOG_LEVEL=INFO
PORT=8000

# AWS SQS Configuration (optional - for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
FAILURES_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/billie-failures
SOLUTIONS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/billie-solutions
POLL_INTERVAL_SECONDS=5
