# Agent runtime. Supabase supplies episodes; Markdown commits are the durable
# memory. The resolver does not yet dispatch physical robot commands.
RESOLVER_MODE=agent
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
OPENAI_API_KEY=replace-with-server-side-openai-key
OPENAI_MODEL=gpt-5.6-luna
FAILURE_EVENTS_TABLE=failure_events
FLOW_FAILURE_RESOLUTIONS_TABLE=flow_failure_resolutions
MEMORY_REPO_URL=https://github.com/bellboy-robotics/failure-resolver-database.git
MEMORY_REPO_BRANCH=failure-resolver-dev
MEMORY_REPO_ROOT=/var/lib/failure-resolver/repository
GITHUB_TOKEN=replace-with-fine-grained-repository-write-token
GIT_ASKPASS=/app/git-askpass.sh
GIT_TERMINAL_PROMPT=0
RESOLVER_AUTO_EXECUTE=false
LOG_LEVEL=INFO
PORT=8000
