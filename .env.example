# Agent runtime. Supabase supplies episodes; Markdown commits are the durable
# memory. Automatic robot commands are disabled unless explicitly enabled and
# allowlisted below.
RESOLVER_MODE=agent
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
OPENAI_API_KEY=replace-with-server-side-openai-key
OPENAI_MODEL=gpt-5.6-luna
FAILURE_EVENTS_TABLE=failure_events
FLOW_FAILURE_RESOLUTIONS_TABLE=flow_failure_resolutions
MEMORY_REPO_URL=https://github.com/bellboy-robotics/failure-resolver-memories.git
MEMORY_REPO_BRANCH=failure-resolver-dev
MEMORY_REPO_ROOT=/var/lib/failure-resolver/repository
GITHUB_TOKEN=replace-with-fine-grained-repository-write-token
GIT_ASKPASS=/app/git-askpass.sh
GIT_TERMINAL_PROMPT=0
RESOLVER_AUTO_EXECUTE=false
RECOVERY_ROBOT_ALLOWLIST=
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_COMMAND_TIMEOUT_SECONDS=15
RECOVERY_OUTCOME_TIMEOUT_SECONDS=60
RECOVERY_LEASE_SECONDS=300
RECOVERY_RECONCILE_INTERVAL_SECONDS=30
RECOVERY_CF_ACCESS_CLIENT_ID=
RECOVERY_CF_ACCESS_CLIENT_SECRET=
LOG_LEVEL=INFO
PORT=8000
